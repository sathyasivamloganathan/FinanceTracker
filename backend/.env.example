# ── REQUIRED ──────────────────────────────────────────────────────────
# MongoDB Atlas connection string (or self-hosted URI)
# Use a dedicated DB user with read/write on this DB only — NOT root/admin.
# Atlas free tier: mongodb+srv://<user>:<pass>@cluster0.xxxxx.mongodb.net/<dbname>?retryWrites=true&w=majority
MONGODB_URI=REPLACE_WITH_YOUR_MONGODB_URI

# JWT secret — minimum 32 random characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET_MIN_32_CHARS
JWT_EXPIRES_IN=7d

# ── SERVER ─────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=4000

# ── FRONTEND ORIGIN (CORS) ────────────────────────────────────────────
# Comma-separated list of URLs the browser frontend is served from.
# No trailing slash. e.g.: https://myapp.azurewebsites.net,https://myapp.com
CLIENT_ORIGINS=http://localhost:3000

# ── EMAIL (SMTP) ──────────────────────────────────────────────────────
# Weekly + monthly summaries, FD maturity alerts, and insurance reminders.
# Gmail: set EMAIL_HOST=smtp.gmail.com, EMAIL_PORT=587, EMAIL_SECURE=false
# Then create an App Password: Google Account → Security → 2-Step Verification → App passwords
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=REPLACE_WITH_YOUR_GMAIL_ADDRESS
EMAIL_PASS=REPLACE_WITH_YOUR_APP_PASSWORD
EMAIL_FROM=REPLACE_WITH_YOUR_GMAIL_ADDRESS

# ── GOOGLE OAUTH (optional) ────────────────────────────────────────────
# Leave these as REPLACE_WITH_... if you only want email/password login.
# Google Cloud Console → APIs & Services → Credentials → Create OAuth 2.0 Client ID
GOOGLE_CLIENT_ID=REPLACE_WITH_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=REPLACE_WITH_GOOGLE_CLIENT_SECRET
GOOGLE_CALLBACK_URL=http://localhost:4000/api/auth/google/callback

# URL the browser lands on after Google OAuth completes
FRONTEND_URL=http://localhost:3000

# ── SESSION ────────────────────────────────────────────────────────────
# Cookie max-age in milliseconds (default 7 days)
COOKIE_MAX_AGE_MS=604800000
